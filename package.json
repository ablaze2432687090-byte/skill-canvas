{
  "name": "skill-canvas",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ablaze2432687090-byte/skill-canvas.git"
  },
  "homepage": "https://github.com/ablaze2432687090-byte/skill-canvas",
  "bugs": {
    "url": "https://github.com/ablaze2432687090-byte/skill-canvas/issues"
  },
  "version": "0.62.0",
  "description": "Skill Canvas Windows desktop creative tool",
  "author": "Skill Canvas",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "bridge": "node bridge/server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts tests/bridge/*.test.mjs",
    "desktop:prepare": "pnpm build && node scripts/collect-licenses.mjs && node scripts/build-desktop.mjs",
    "desktop:dev": "pnpm desktop:prepare && electron .",
    "desktop:pack": "pnpm audit && pnpm desktop:prepare && node scripts/package-desktop.mjs && node scripts/verify-packaged-release.mjs",
    "release:audit": "node scripts/audit-release.mjs",
    "test:desktop-unit": "node --test tests/desktop/*.test.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@11.19.0"
}
